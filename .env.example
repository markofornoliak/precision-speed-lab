# Server
HOST=0.0.0.0
PORT=3000
NODE_ENV=production

# Maximum single upload/download transfer (500 MiB)
MAX_TRANSFER_BYTES=524288000

# Streaming internals
DOWNLOAD_CHUNK_BYTES=262144
RANDOM_POOL_BYTES=4194304

# Concurrency protection. These limits cap stream count, not bandwidth.
MAX_ACTIVE_TRANSFERS=128
MAX_ACTIVE_PER_CLIENT=16

# Set to 1 only when deployed behind a trusted reverse proxy/load balancer.
TRUST_PROXY=0

# Leave blank for same-origin frontend + backend.
# Example for split hosting: https://example.com
CORS_ORIGIN=
