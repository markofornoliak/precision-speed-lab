# Listener. Render injects PORT (normally 10000); local Docker defaults to 3000.
HOST=0.0.0.0
PORT=3000
NODE_ENV=production

# Measurement node identity / regional discovery.
MEASUREMENT_NODE_ID=fra-1
MEASUREMENT_REGION=eu-central
PUBLIC_BASE_URL=https://fra.example.net
MEASUREMENT_SERVERS_JSON=

# Maximum bytes accepted by one upload/download request (500 MiB default).
MAX_TRANSFER_BYTES=524288000
DOWNLOAD_CHUNK_BYTES=262144
RANDOM_POOL_BYTES=4194304
UPLOAD_IDLE_TIMEOUT_MS=30000

# Transfer concurrency and byte/request quotas inside the measurement server.
MAX_ACTIVE_TRANSFERS=128
MAX_ACTIVE_PER_CLIENT=16
RATE_WINDOW_MS=60000
MAX_REQUESTS_PER_WINDOW=900
MAX_BYTES_PER_WINDOW=8589934592

# Production gateway: socket cap, token-bucket admission and graceful load shedding.
MAX_CONNECTIONS=2048
MAX_RSS_MIB=430
SHED_RSS_RATIO=0.92
SHED_EVENT_LOOP_UTILIZATION=0.97
ADMISSION_BURST_TOKENS=180
ADMISSION_REFILL_PER_SECOND=6

# Set only behind a trusted proxy/load balancer that overwrites X-Forwarded-For.
# Render's edge proxy satisfies this requirement.
TRUST_PROXY=0

# Same-origin needs no CORS setting. For GitHub Pages / split regional nodes,
# use a comma-separated allowlist, e.g. https://markofornoliak.github.io
CORS_ORIGINS=

# Prometheus text endpoint. Disabled by default. When enabled publicly, set a token.
ENABLE_METRICS=0
METRICS_TOKEN=

# debug also logs high-frequency ping/progress requests; info avoids measurement-side log noise.
LOG_LEVEL=info
